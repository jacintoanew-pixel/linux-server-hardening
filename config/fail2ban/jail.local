[DEFAULT]
bantime  = 1h
findtime  = 10m
maxretry = 4
backend = systemd
banaction = ufw

[sshd]
enabled = true
backend = systemd

[nginx-http-auth]
enabled = true
backend = auto
logpath = /var/log/nginx/error.log

[nginx-botsearch]
enabled = true
backend = auto
logpath = /var/log/nginx/access.log
maxretry = 3
