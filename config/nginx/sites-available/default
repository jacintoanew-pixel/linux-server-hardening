# -------------------------------------------------------------------------
# 5. Redirecciones Obligatorias HTTP -> HTTPS para Sitios con SSL
# -------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name panel.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 80;
    server_name tenant_a.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 80;
    server_name tenant_b.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 80;
    server_name tenant_c.example.com;
    return 301 https://$host$request_uri;
}

# -------------------------------------------------------------------------
# 6. Wildcard Multi-Tenant para Subdominios de Proyectos (HTTP)
# Excluye nombres reservados y bloquea accesos no autorizados (SEC-18 / SEC-22)
# -------------------------------------------------------------------------
server {
    listen 80;
    server_name ~^(?!(panel|html|admin|credentials|api)$)(?<subdomain>[a-z0-9_-]+)\.example\.com$;
    root /var/www/$subdomain;
    index index.html index.php;
    disable_symlinks if_not_owner from=$document_root;

    # Cabeceras de seguridad
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Desactivar caché del navegador para desarrollo y despliegues en tiempo real

    error_page 403 404 /404.html;
    location = /404.html {
        root /var/www/html;
        internal;
    }

    location ~ /\.(?!well-known) {
        deny all;
        access_log off;
        log_not_found off;
    }

    location ~* \.(json|lock|git|env|sql|bak|config|sh|log|md|zip|tar|gz)$ {
        deny all;
        access_log off;
        log_not_found off;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.5-fpm-wildcard.sock;
        fastcgi_param PHP_ADMIN_VALUE "open_basedir=/var/www/$subdomain/:/tmp/
disable_functions=exec,passthru,shell_exec,system,proc_open,popen,symlink,link,pcntl_exec,pcntl_fork,dl,putenv,mail,posix_kill,posix_mkfifo,posix_setuid,curl_exec,curl_multi_exec";
    }
}
