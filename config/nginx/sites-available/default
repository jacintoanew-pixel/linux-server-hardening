# =========================================================================
# Production Nginx Configuration - Multi-Tenant Hardened
# =========================================================================

# Límites de subida y Rate Limiting
client_max_body_size 100M;
limit_req_zone $binary_remote_addr zone=panel_req:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=auth_req:10m rate=5r/s;
# Fix P0 H-1: freno exclusivo del endpoint de despliegue (rutas sanitizadas de referencia)
limit_req_zone $binary_remote_addr zone=deploy_req:10m rate=5r/s;

# -------------------------------------------------------------------------
# BLOQUES DEFAULT CATCH-ALL (Anti-Host Spoofing / Anti-Leak SEC-18)
# Cierra inmediatamente cualquier conexión a hosts no autorizados o IPs crudas
# -------------------------------------------------------------------------
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_certificate /etc/letsencrypt/live/panel.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/panel.example.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    return 444;
}

# -------------------------------------------------------------------------
# 1. Panel de Control y Autenticación Administrativa
# -------------------------------------------------------------------------
server {
    server_name panel.example.com;
    root /var/www/html;
    index index.php index.html;

    # Compatibilidad transparente para endpoints modularizados (rutas de referencia sanitizadas)
    location = /deploy.php { rewrite ^ /api/v1/deploy.php last; }
    location = /metrics.php { rewrite ^ /api/v1/metrics.php last; }
    location = /auth.php { rewrite ^ /includes/session_auth.php last; }
    disable_symlinks if_not_owner from=$document_root;

    # Cabeceras de Seguridad HTTPS
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self';" always;

    # Página 404 personalizada
    error_page 403 404 /404.html;
    location = /404.html {
        root /var/www/html;
        internal;
    }

    # Bloqueo estricto de archivos ocultos (dotfiles) excepto Let's Encrypt
    location ~ /\.(?!well-known) {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Bloqueo de archivos sensibles internos (JSON, DB, logs, scripts, backups)
    location ~* \.(json|lock|git|env|sql|bak|config|sh|log|md|zip|tar|gz)$ {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Rate limiting estricto para autenticación
    location ~ ^/(login|auth)\.php$ {
        limit_req zone=auth_req burst=5 nodelay;
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.5-fpm.sock;
        fastcgi_param PHP_ADMIN_VALUE "open_basedir=/var/www/:/etc/webapp/:/tmp/:/proc/";
    }

    location / {
        limit_req zone=panel_req burst=30 nodelay;
        try_files $uri $uri/ =404;
    }

    # Fix P0 H-1: tras el rewrite del alias, esta es la location final del deploy
    location ~ ^/api/v1/deploy\.php$ {
        limit_req zone=deploy_req burst=15 nodelay;
        limit_req_status 429;
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.5-fpm.sock;
        fastcgi_param PHP_ADMIN_VALUE "open_basedir=/var/www/:/etc/webapp/:/tmp/:/proc/";
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.5-fpm.sock;
        fastcgi_param PHP_ADMIN_VALUE "open_basedir=/var/www/:/etc/webapp/:/tmp/:/proc/";
    }

    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    ssl_certificate /etc/letsencrypt/live/panel.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/panel.example.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

# -------------------------------------------------------------------------
# 2. Espacio Web de Tenant A
# -------------------------------------------------------------------------
server {
    server_name tenant_a.example.com;
    root /var/www/tenant_a;
    index index.html index.php index.htm;
    disable_symlinks if_not_owner from=$document_root;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Desactivar caché del navegador para desarrollo y despliegues en tiempo real

    # Página 404 personalizada (Nada aquí todavía)
    error_page 403 404 /404.html;
    location = /404.html {
        root /var/www/html;
        internal;
    }

    location ~ /\.(?!well-known) {
        deny all;
        access_log off;
        log_not_found off;
    }

    location ~* \.(json|lock|git|env|sql|bak|config|sh|log|md|zip|tar|gz)$ {
        deny all;
        access_log off;
        log_not_found off;
    }

    
    # Optimizacion de imagenes y Open Graph para WhatsApp y redes sociales
    location ~* \.(jpg|jpeg|png|gif|ico|webp|svg)$ {
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age=604800, must-revalidate" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.5-fpm-tenant_a.sock;
        fastcgi_param PHP_ADMIN_VALUE "open_basedir=/var/www/tenant_a/:/tmp/
disable_functions=exec,passthru,shell_exec,system,proc_open,popen,symlink,link,pcntl_exec,pcntl_fork,dl,putenv,mail,posix_kill,posix_mkfifo,posix_setuid,curl_exec,curl_multi_exec";
    }

    listen 443 ssl;
    http2 on;
    ssl_certificate /etc/letsencrypt/live/panel.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/panel.example.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

